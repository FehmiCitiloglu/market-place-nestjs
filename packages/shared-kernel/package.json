{
  "name": "@mercato/shared-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mercato shared kernel: identifiers, money, errors, domain events, clock, pagination",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
