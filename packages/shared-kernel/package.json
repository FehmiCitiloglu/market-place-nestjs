    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "fast-check": "^4.10.2",
    "@types/node": "^24.19.2"
  }
}
