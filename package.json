{
  "name": "mercato",
  "version": "0.1.0",
  "private": true,
  "description": "Mercato \u2014 production-oriented, security-first multi-vendor marketplace backend",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 test",
    "test:unit": "pnpm build && pnpm --filter @mercato/api test:unit",
    "test:integration": "pnpm build && pnpm --filter @mercato/api test:integration",
    "db:generate": "pnpm --filter @mercato/api db:generate",
    "db:migrate": "pnpm --filter @mercato/api db:migrate",
    "db:push": "pnpm --filter @mercato/api db:push",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "dev": "pnpm --filter @mercato/api dev",
    "start": "pnpm --filter @mercato/api start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
