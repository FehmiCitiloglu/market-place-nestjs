# Mercato — local development environment template.
# Copy to .env and adjust. NEVER commit real secrets (CI runs secret scanning).

# --- runtime ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_BODY_LIMIT_BYTES=1048576
API_TRUST_PROXY=false
# Comma-separated browser origins allowed for CORS. Empty = same-origin only.
API_CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=info
LOG_PRETTY=true

# --- postgres ---
MERCATO_POSTGRES_USER=mercato
MERCATO_POSTGRES_PASSWORD=mercato-dev-only
MERCATO_POSTGRES_DB=mercato
MERCATO_POSTGRES_PORT=55432
DATABASE_URL=postgres://mercato:mercato-dev-only@127.0.0.1:55432/mercato
DATABASE_POOL_MAX=10
# Separate migration credentials; defaults to DATABASE_URL when omitted.
# DATABASE_MIGRATION_URL=postgres://mercato_migrator:...@127.0.0.1:55432/mercato

# --- redis ---
MERCATO_REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# --- sessions & CSRF ---
# Must be >= 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
SESSION_COOKIE_NAME=mercato_session
SESSION_TTL_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=86400
CSRF_COOKIE_NAME=mercato_csrf

# --- object storage (LocalStack S3 locally) ---
MERCATO_S3_PORT=9000
MERCATO_S3_CONSOLE_PORT=9001
MERCATO_S3_ROOT_USER=minioadmin
MERCATO_S3_ROOT_PASSWORD=minioadmin-dev-only
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test-secret-key-local-dev
S3_BUCKET_PUBLIC=mercato-public
S3_BUCKET_PRIVATE=mercato-private
S3_FORCE_PATH_STYLE=true

# --- mail (Mailpit locally) ---
MERCATO_MAIL_SMTP_PORT=1025
MERCATO_MAIL_UI_PORT=8025
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_FROM="Mercato <no-reply@mercato.local>"

# --- payments (mock provider) ---
PAYMENT_PROVIDER=mock
# Webhook signing secret (HMAC-SHA256 over raw body). >= 32 chars.
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me-012345678

# --- rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- observability ---
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
